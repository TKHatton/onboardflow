# OnboardFlow Environment Configuration
# Copy this to .env and fill in your values

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Gemini API Key (get from https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=AQ.Ab8RN6KDdx4-cbSUPPp9DfUSa2luxxOQ077991j2WejjxkkPzQ

# Optional: Use Vertex AI instead of Gemini API
# GOOGLE_GENAI_USE_VERTEXAI=true

# Firestore Configuration
FIRESTORE_PROJECT_ID=your-project-id
FIRESTORE_DATABASE_ID=(default)

# Pub/Sub Configuration
PUBSUB_TOPIC_NEW_HIRE=new-hire-events

# Optional: Real API credentials (for production)
# JIRA_API_TOKEN=your-jira-token
# JIRA_DOMAIN=your-domain.atlassian.net
# SLACK_BOT_TOKEN=xoxb-your-token
# SLACK_CHANNEL=#general
